# QVerse Environment Configuration Example
# Copy this file to .env and configure values appropriately for your deployment

DEBUG=True
SECRET_KEY=django-insecure-development-key-change-in-production-qverse-2026
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite in local dev)
DATABASE_URL=sqlite:///db.sqlite3

# Execution Constraints
MAX_CIRCUIT_QUBITS=16
MAX_CIRCUIT_SHOTS=10000
MAX_OPTIMIZATION_NODES=20
EXECUTION_TIMEOUT_SECONDS=60
